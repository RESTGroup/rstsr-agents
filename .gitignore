# >>> Code Agent <<< #

# Agent directory
.claude
.agents
.claude.json
.codex

# Aider chat history & caches
.aider*

# Cursor / Continue / Roo local state (shared rules are committed separately)
.cursor/
.continue/
.roo/

# Catch-all for local-only files (e.g. *.local.toml, *.local.md)
*.local*

# Scratch output / agent session artifacts
tmp*
__pycache__/

# CLAUDE.md at root directory
# This repository uses AGENTS.md (usual agent file).
# For Claude Code users, you need to create a symlink from AGENTS.md.
/CLAUDE.md

# Campaign plans (agent working material, deliberately not tracked)
/plans/

# Memory files (related to user's personal perferences)
/memory/

# Settings files (related to user's personal perferences)
settings.json
